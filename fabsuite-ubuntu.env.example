# FabLab Suite - Ubuntu installer config (monorepo)
# Copy to fabsuite-ubuntu.env then adjust values.

# Monorepo Git URL (source unique de mise à jour)
GIT_REPO_URL=https://github.com/fablabloritz-coder/Fablab-Suite.git
GIT_BRANCH=main

# Target folder where the monorepo is cloned on the server
INSTALL_DIR=$HOME/fablab-suite

# Apps managed by the helper script (space-separated)
APPS="FabHome Fabtrack PretGo FabBoard FabInventory"

# Shared runtime settings
TZ=Europe/Paris
FLASK_SECRET_KEY=

# Published ports
FABHOME_PORT=3001
FABTRACK_PORT=5555
PRETGO_PORT=5000
FABBOARD_PORT=5580
FABINVENTORY_PORT=5590

# Optional volume paths (can be absolute paths to preserve existing data)
FABHOME_DATA_PATH=./data
FABHOME_ICONS_PATH=./icons

# Optional overrides for inter-app URLs (container -> host).
# Leave empty to use host.docker.internal:<port> defaults.
FABTRACK_URL=
PRETGO_URL=
FABBOARD_URL=
FABINVENTORY_URL=

# Dossier racine des snapshots de sauvegarde (defaut: $HOME/backup-fabsuite)
# FABSUITE_BACKUP_DIR=$HOME/backup-fabsuite

# Retention des snapshots (le dernier snapshot valide est toujours conserve)
# FABSUITE_BACKUP_RETENTION_COUNT=7   # nombre de snapshots a garder (defaut)
# FABSUITE_BACKUP_RETENTION_DAYS=0    # > 0 : retention par age, prioritaire

# Dossier de staging par defaut pour la restauration (defaut: $HOME/restore-fabsuite)
# FABSUITE_RESTORE_DIR=$HOME/restore-fabsuite

# Planification des snapshots (action install-backup-timer)
# FABSUITE_BACKUP_ON_CALENDAR="*-*-* 03:30:00"   # syntaxe systemd OnCalendar

# Verification periodique des snapshots (action install-verify-timer)
# FABSUITE_VERIFY_ON_CALENDAR="daily"        # syntaxe systemd OnCalendar (defaut: daily)
# FABSUITE_VERIFY_ON_CALENDAR="*-*-* 04:30:00"

# Notifications externes en cas d'echec d'un backup ou d'une verification
# planifies. Laisser vide pour desactiver. Les deux cibles sont independantes.
# Webhook : POST JSON {"service","status","code","host","message"} (curl requis)
# FABSUITE_NOTIFY_WEBHOOK_URL=https://exemple.invalid/hook/fabsuite
# Email : necessite la commande mail ou sendmail sur l'hote
# FABSUITE_NOTIFY_EMAIL=admin@exemple.invalid
# Anti-rebond : une seule alerte par serie d'echecs consecutifs. L'etat
# (notify-<service>.state) est supprime apres une execution reussie, ce qui
# reautorise un envoi a la panne suivante.
#   ./fabsuite-ubuntu.sh notify-reset --notify-service backup|verify

# Snapshot automatique avant update (actif par defaut)
# FABSUITE_UPDATE_SKIP_BACKUP=1            # ne pas sauvegarder avant update
# FABSUITE_UPDATE_REQUIRE_VERIFIED_BACKUP=1  # annuler update si le snapshot est invalide

# Optional custom volume paths (uncomment if needed)
# FABTRACK_DATA_PATH=./docker-data/data
# FABTRACK_UPLOADS_PATH=./docker-data/uploads
# PRETGO_DATA_PATH=./docker-data/data
# PRETGO_UPLOADS_PATH=./docker-data/uploads/materiel
# FABBOARD_DATA_PATH=./docker-data/data
# FABINVENTORY_DATA_PATH=./docker-data/data
